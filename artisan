#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// StockFlow tourne dans Docker : PHP 8.4 et les dépendances sont dans le conteneur
// « app ». Lancé avec le PHP du poste (XAMPP par exemple), artisan s'arrête ici avec
// une consigne claire au lieu d'une erreur sur vendor/autoload.php.
if (! file_exists(__DIR__.'/vendor/autoload.php') || PHP_VERSION_ID < 80300) {
    fwrite(STDERR, implode(PHP_EOL, [
        '',
        'StockFlow s\'exécute dans Docker, pas avec le PHP de ce poste (PHP '.PHP_VERSION.' ici, 8.3 au minimum requis).',
        '',
        'Depuis le dossier du projet, utilisez :',
        '    artisan.cmd <commande>                       (Windows, par exemple : artisan.cmd migrate:status)',
        '    docker compose exec app php artisan <commande>',
        '',
        'Si le conteneur ne tourne pas : lancez Docker Desktop, puis « docker compose up -d ».',
        '',
    ]).PHP_EOL);
    exit(1);
}

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
