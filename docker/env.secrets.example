# Modèle de .env.secrets, à copier à la racine du dépôt sur le serveur de production :
#
#   cp docker/env.secrets.example .env.secrets && chmod 600 .env.secrets
#
# Ce fichier n'est lu que par Docker Compose (scripts/prod-compose.sh). Son contenu va au
# conteneur db (mot de passe root de MySQL) et, au premier déploiement seulement, au
# seeder de référence (mot de passe initial de l'administrateur). Le conteneur app, donc
# PHP, ne le voit jamais. Ne le versionnez pas ; gardez-en une copie avec .env.production.

# Mot de passe root de MySQL : fort, sans $, #, guillemet ni espace (openssl rand -hex 24).
DB_ROOT_PASSWORD=

# Mot de passe initial du premier administrateur (12 caractères au moins), à changer à la
# première connexion. Vide : un mot de passe est tiré au hasard et affiché une seule fois
# par scripts/deploy.sh. À vider après la première connexion.
ADMIN_PASSWORD=
