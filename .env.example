# Copier ce fichier en .env puis lancer : php artisan key:generate
# Aucune valeur réelle de production ne doit figurer ici.

APP_NAME=StockFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file

# Coût du hachage Bcrypt des mots de passe.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données. "db" est le nom du service MySQL dans compose.yaml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=secret
# Lu par compose.yaml uniquement (compte root du conteneur MySQL).
DB_ROOT_PASSWORD=root-secret

# Ports publiés sur le poste par compose.yaml.
APP_PORT=8080
FORWARD_DB_PORT=3307
VITE_PORT=5173

# Sessions : durée en minutes. En production, SESSION_SECURE_COOKIE=true (HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# L'application n'envoie pas d'e-mail (décision D-010).
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
