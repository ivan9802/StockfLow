# Copier ce fichier en .env puis lancer : php artisan key:generate
# Aucune valeur réelle de production ne doit figurer ici.

APP_NAME=StockFlow
APP_ENV=local
APP_KEY=
# Anciennes clés, séparées par des virgules, gardées le temps d'une rotation de APP_KEY :
# les sessions et cookies chiffrés avec elles restent lisibles. Vide en temps normal.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Abidjan

APP_MAINTENANCE_DRIVER=file

# Coût du hachage Bcrypt des mots de passe.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Nombre de fichiers journaliers conservés (un par jour) avant suppression automatique.
LOG_DAILY_DAYS=30

# Base de données. "db" est le nom du service MySQL dans compose.yaml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=secret
# Lu par compose.yaml uniquement (compte root du conteneur MySQL), en développement.
# En production, cette variable va dans .env.secrets (modèle : docker/env.secrets.example),
# jamais dans .env.production : le conteneur PHP ne doit pas pouvoir la lire.
DB_ROOT_PASSWORD=root-secret

# Ports publiés sur le poste par compose.yaml.
APP_PORT=8080
FORWARD_DB_PORT=3307
VITE_PORT=5173

# Sessions. SESSION_LIFETIME : durée d'inactivité en minutes. SESSION_EXPIRE_ON_CLOSE :
# la session se termine à la fermeture du navigateur (postes partagés).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# false pour le développement en HTTP. En production, mettre true (cookie envoyé en HTTPS
# seulement) ; sans cette variable, la valeur est true quand APP_ENV=production.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# L'application n'envoie pas d'e-mail (décision D-010).
MAIL_MAILER=log

# Proxies de confiance. Vide en développement ; "*" en production, derrière le proxy
# inverse TLS (le service web n'y écoute que sur 127.0.0.1).
TRUSTED_PROXIES=

# Premier administrateur, créé par ReferenceDataSeeder s'il n'en existe aucun.
# Sans ADMIN_PASSWORD, un mot de passe est tiré au hasard et affiché une seule fois.
# En production, ADMIN_PASSWORD va dans .env.secrets, jamais dans .env.production.
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@stockflow.example
ADMIN_PASSWORD=

# Identité de l'entreprise : écran de connexion, bons imprimés, mentions légales.
COMPANY_NAME="Ivoire Bureautique & Tech"
COMPANY_ADDRESS="Abidjan, Côte d'Ivoire"
COMPANY_PHONE=
COMPANY_EMAIL=contact@example.com
COMPANY_RCCM=
COMPANY_PUBLISHER=
COMPANY_HOST=
